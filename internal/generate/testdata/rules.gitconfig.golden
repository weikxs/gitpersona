# Generated by GitPersona from config.toml. Do not edit: run `gitpersona apply`.
# Order is precedence: the default, then directory rules from least to most specific with your
# own includeIf rules among them (in your order), then pins.

# Default profile: acme
[include]
	path = /tmp/home/.config/gitpersona/profiles/acme.gitconfig

# Rule: ~/Projects/acme -> acme
[includeIf "gitdir/i:/tmp/home/Projects/acme/"]
	path = /tmp/home/.config/gitpersona/profiles/acme.gitconfig

# Rule: ~/Projects/acme/oss -> personal
[includeIf "gitdir/i:/tmp/home/Projects/acme/oss/"]
	path = /tmp/home/.config/gitpersona/profiles/personal.gitconfig

# Rule: ~/Projects/personal -> personal
[includeIf "gitdir/i:/tmp/home/Projects/personal/"]
	path = /tmp/home/.config/gitpersona/profiles/personal.gitconfig

# Rule: ~/Projects/clients/globex -> globex
[includeIf "gitdir/i:/tmp/home/Projects/clients/globex/"]
	path = /tmp/home/.config/gitpersona/profiles/globex.gitconfig

# Pin: ~/Downloads/globex-hotfix -> globex (the repository and its worktrees)
[includeIf "gitdir/i:/tmp/home/Downloads/globex-hotfix/.git"]
	path = /tmp/home/.config/gitpersona/profiles/globex.gitconfig
[includeIf "gitdir/i:/tmp/home/Downloads/globex-hotfix/.git/worktrees/"]
	path = /tmp/home/.config/gitpersona/profiles/globex.gitconfig
