# Profile personal: octo-alex on github.com
[user]
	name = Alex Octo
	email = 1000001+octo-alex@users.noreply.github.com
[user]
	signingkey = /tmp/home/.ssh/id_ed25519_personal.pub
[gpg]
	format = ssh
[commit]
	gpgsign = true
[core]
	sshCommand = ssh
[credential "https://github.com"]
	helper = ""
	helper = !'/opt/tools/gitpersona' credential --provider github --host 'github.com' --account 'octo-alex'
	username = octo-alex
